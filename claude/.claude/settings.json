{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-desktop.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-desktop.sh"
          }
        ]
      }
    ]
  },
  "theme": "dark-daltonized",
  "verbose": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "tui": "fullscreen"
}
