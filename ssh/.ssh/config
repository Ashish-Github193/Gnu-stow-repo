# ~/.ssh/config

Host *
    SetEnv TERM=xterm-256color
	AddKeysToAgent yes
	ControlMaster auto
	ControlPersist 10m
	ControlPath ~/.ssh/cm-%r@%h:%p

Host jump
    HostName 151.185.45.156
	User ashishj
	ForwardAgent yes
	IdentityFile ~/Projects/Secrets/secrets/secret.ssh_keys/bastion/id_rsa

Host newbox
    HostName 10.106.60.18
    User x
	ProxyJump jump
	IdentityFile ~/Projects/Secrets/secrets/secret.ssh_keys/ashishj/id_rsa

Host github.com
    HostName github.com
    User git
    IdentityFile ~/Projects/Secrets/secrets/secret.ssh_keys/github/id_rsa

Host bitbucket.org
    HostName bitbucket.org
    User git
    IdentityFile ~/Projects/Secrets/secrets/secret.ssh_keys/bitbucket/id_rsa

Host a
	HostName 192.168.0.105
	User a
	IdentityFile ~/Projects/Secrets/secrets/secret.ssh_keys/peer/id_rsa

# Local machine via reverse-ssh tunnel (key auth; passwordless)
Host localbox
	HostName localhost
	Port 43022
	User x
	IdentitiesOnly yes
	IdentityFile ~/.ssh/id_ed25519

# AWS dev VM (SSM-only, no public IP) — SSH-over-SSM tunnel. AAP-1608.
# First: aws sso login --sso-session analystt
# The --profile below must match the profile `aws configure sso` created (rename there if needed).
Host devbox
    HostName i-0450edc3ac58242fa
    User ashishj
    IdentitiesOnly yes
    IdentityFile ~/Projects/Secrets/secrets/secret.ssh_keys/ashishj/id_rsa
    ProxyCommand aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p --region ap-south-1 --profile analystt-admin
